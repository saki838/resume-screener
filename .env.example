# Copy to .env and fill in. Everything is optional: with no keys the pipeline runs
# fully deterministic and records GitHub/LLM status per candidate.

# GitHub: raises the API limit from 60 to 5,000 requests/hour. No scopes needed.
GITHUB_TOKEN=
GITHUB_ENABLED=true
GITHUB_CONCURRENCY=5
GITHUB_PARTIAL_POLICY=neutralize  # neutralize | keep (when some lookups are rate-limited)
GITHUB_USE_EVENTS=auto       # auto = only with a token (adds 1 call/user for recent commits)

# LLM-assisted AI-depth judgment (hybrid mode). Leave all empty for deterministic mode.
# LLM_PROVIDER=auto picks the first configured: ANTHROPIC_API_KEY, GEMINI_API_KEY, GROQ_API_KEY, LLM_BASE_URL.
LLM_PROVIDER=auto            # auto | gemini | groq | ollama | openai_compatible | anthropic | none

# Free option 1: Google Gemini free tier (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Free option 2: Groq free tier (key from https://console.groq.com/keys). Also set LLM_PROVIDER=groq
# if a Gemini key is present too, and leave LLM_MODEL empty (default openai/gpt-oss-120b).
GROQ_API_KEY=

# Free option 3: local Ollama (no key). Set LLM_PROVIDER=ollama and LLM_MODEL=<pulled model>.
# Other OpenAI-compatible APIs (Groq, OpenRouter, ...): set LLM_BASE_URL, LLM_MODEL, LLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
# LLM_MODEL empty = provider default (gemini-3.8-flash / openai/gpt-oss-120b / claude-sonnet-5-5)
LLM_MODEL=

# Paid option: Anthropic Claude
ANTHROPIC_API_KEY=

LLM_BLEND=0.5                # final AI depth = (1-b)*rules + b*LLM
LLM_PARTIAL_POLICY=neutralize  # neutralize | keep (when only some LLM calls succeed)
# Leave empty to use provider presets (Gemini free tier: 1 at a time, 6s apart, 4 retries)
LLM_CONCURRENCY=
LLM_MIN_INTERVAL_S=
LLM_MAX_RETRIES=
# Overload handling (empty = preset). Gemini: 120s timeout; waits 10/20/40/60s after a 503;
# stops calling after 3 resumes in a row fail every retry.
LLM_TIMEOUT_S=
LLM_BUSY_BACKOFF_S=
LLM_MAX_CONSECUTIVE_FAILURES=
# Token budget (empty = preset; Groq: 8,000 resume characters, 2,500 output tokens)
LLM_MAX_RESUME_CHARS=
LLM_MAX_OUTPUT_TOKENS=

# Parsing
PARSE_WORKERS=4

# Policy
ACCEPT_CLASSIC_ML_AS_AI=true # false = only LLM/RAG/agentic work passes the AI filter

# Disk cache for GitHub/LLM responses (re-runs are fast and reproducible)
CACHE_ENABLED=true
CACHE_DIR=.cache
